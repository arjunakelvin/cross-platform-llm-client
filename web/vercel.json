{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    {
      "source": "/api/admin/:path*",
      "destination": "/api/worker?kind=admin&path=:path*"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/worker?kind=auth&path=:path*"
    },
    {
      "source": "/api/bot/:path*",
      "destination": "/api/worker?kind=bot&path=:path*"
    },
    {
      "source": "/api/discord/:path*",
      "destination": "/api/worker?kind=discord&path=:path*"
    },
    {
      "source": "/api/gateway/:path*",
      "destination": "/api/worker?kind=gateway&path=:path*"
    },
    {
      "source": "/api/((?!admin|auth|bot|discord|gateway).*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api|favicon\\.png|icons|manifest\\.json|flutter_bootstrap\\.js|main\\.dart\\.js|assets).*)",
      "destination": "/index.html"
    }
  ]
}
