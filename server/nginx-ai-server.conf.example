# Contoh nginx untuk AI server + Server Manager.
#
#   /etc/nginx/sites-available/api-ai
#   ln -s /etc/nginx/sites-available/api-ai /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
#
# AturanDasar: setiap request harus membawa header X-Secret-Key yang cocok,
# jadi server AI tidak bisa dipakai orang lain yang kebetulan tahu URL-nya.

server {
    listen 80;
    server_name api-ai.domainkamu.com;   # ganti dengan domain milikmu

    # ── CORS untuk web client (browser) ──────────────────────────────
    add_header Access-Control-Allow-Origin  "*" always;
    add_header Access-Control-Allow-Headers "Authorization, Content-Type, X-Secret-Key, X-Admin-Key" always;
    add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;

    # ── 1. Manager API ────────────────────────────────────────────────
    # Start/stop server AI, status CPU/RAM/disk/network, dan log.
    location /manager/ {
        if ($http_x_secret_key != "GANTI_DENGAN_KUNCI_PANJANG_DAN_ACAK_1234567890") {
            return 403 "Akses Ditolak!";
        }

        proxy_pass http://127.0.0.1:8788;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Secret-Key $http_x_secret_key;
    }

    # ── 2. Inference (OpenAI-compatible) ──────────────────────────────
    # Ollama defaultnya di 11434. llama.cpp/llama-server pakai port lain,
    # jadi taruh tiap instance di location terpisah (lihat di bawah).
    location / {
        if ($http_x_secret_key != "GANTI_DENGAN_KUNCI_PANJANG_DAN_ACAK_1234567890") {
            return 403 "Akses Ditolak!";
        }

        proxy_pass http://127.0.0.1:11434;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Secret-Key $http_x_secret_key;

        # Jangan buffer response — chat streaming harus masuk per token.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # Contoh AI server kedua (llama.cpp) dengan prefix /llamacpp:
    # location /llamacpp/ {
    #     if ($http_x_secret_key != "GANTI_DENGAN_KUNCI_PANJANG_DAN_ACAK_1234567890") {
    #         return 403 "Akses Ditolak!";
    #     }
    #     proxy_pass http://127.0.0.1:11435/;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Secret-Key $http_x_secret_key;
    #     proxy_buffering off;
    #     proxy_read_timeout 600s;
    # }

    if ($request_method = OPTIONS) {
        return 204;
    }
}
